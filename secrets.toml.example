# Copy this file to secrets.toml (same folder) and fill in real values.
# secrets.toml is the RECOMMENDED place for the login username/password —
# it's read automatically by app.py and is NOT committed to git (see .gitignore),
# so your real password never ends up on GitHub.
#
# If you skip this file entirely, the app just falls back to the
# APP_USERNAME / APP_PASSWORD values inside app.py instead — fine for
# testing locally, but avoid that if you're pushing this repo to GitHub
# for Streamlit Community Cloud.

[auth]
username = "her_username"
password = "your_secret_password"
